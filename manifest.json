{
  "manifest_version": 3,
  "name": "CU-LMS Fixer",
  "version": "1.8.0",
  "description": "Unblock copy & paste everywhere, one-click PDF/PPT downloads, section batch downloads, and popup controls across CU LMS, CUIMS, and portals.",
  "permissions": ["downloads", "clipboardWrite", "storage", "alarms"],
  "host_permissions": [
    "*://*.cuchd.in/*",
    "*://*.cuims.in/*",
    "*://*.cuidol.in/*",
    "*://*.onlinecu.in/*",
    "*://*.culko.in/*",
    "*://*.chandigarhuniversity.ac.in/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.cuchd.in/*",
        "*://*.cuims.in/*",
        "*://*.cuidol.in/*",
        "*://*.onlinecu.in/*",
        "*://*.culko.in/*",
        "*://*.chandigarhuniversity.ac.in/*"
      ],
      "js": ["unblock_copypaste_main.js"],
      "world": "MAIN",
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "*://*.cuchd.in/*",
        "*://*.cuims.in/*",
        "*://*.cuidol.in/*",
        "*://*.onlinecu.in/*",
        "*://*.culko.in/*",
        "*://*.chandigarhuniversity.ac.in/*"
      ],
      "js": ["unblock_copypaste.js"],
      "css": ["unblock_copypaste.css"],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "https://lms.cuchd.in/*",
        "*://culms.cuidol.in/*",
        "*://lms.culko.in/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://students.cuchd.in/*",
        "https://uims.cuchd.in/*",
        "*://*.cuims.in/*"
      ],
      "js": ["tesseract.min.js", "content_students.js"],
      "css": ["content_students.css"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["unblock_copypaste_main.js"],
      "matches": [
        "*://*.cuchd.in/*",
        "*://*.cuims.in/*",
        "*://*.cuidol.in/*",
        "*://*.onlinecu.in/*",
        "*://*.culko.in/*",
        "*://*.chandigarhuniversity.ac.in/*"
      ]
    }
  ]
}
